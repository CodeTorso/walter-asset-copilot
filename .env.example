# Copy to .env.local (or pass with `bun --env-file=...`) and fill in what you use.
# At least one model route is required. Walter tries them in this order: OpenRouter, Vercel AI Gateway, Google AI Studio.

# OpenRouter: Gemma 4 pinned to the 3 fastest tool-capable hosts (recommended)
OPENROUTER_API_KEY=
# Vercel AI Gateway (on Vercel, OIDC is used automatically; locally, use a key)
AI_GATEWAY_API_KEY=
# Google AI Studio: Gemma 4 fallback (and Gemini Live voice, if enabled)
GOOGLE_GENERATIVE_AI_API_KEY=

# Database: leave empty to use local PGlite in .data/pglite (or set PGLITE_DIR)
DATABASE_URL=
# Direct (unpooled) Neon connection, used by the importer
DATABASE_URL_UNPOOLED=
# PGLITE_DIR=.data/pglite

# Optional tuning
# WALTER_PROVIDER=openrouter        # openrouter | gateway | google: which route to try first
# WALTER_MODEL_FIRST=31b            # 31b | 26b: which Gemma 4 model to try first
# WALTER_OR_SORT=e2e                # e2e | latency | throughput: how OpenRouter hosts are ranked
# WALTER_DEBUG=1                    # log every model stream event
